# LLM access (used by models.py's get_llm for the student/evaluator/scorer/summarizer agents)
OPENROUTER_API_KEY=

# MongoDB (memory.py / db.py)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=teach2learn

# RAG ingestion (ingest.py) and vectorstore (qa_generator.py, student_chain.py)
DATA_DIR=./data
VS_DIR=./vectorstore

# Multilingual. Translation wraps only participant-visible text; the student agent,
# evaluator agent, scorer agent, and everything stored in MongoDB always stay English.
# Backend "sarvam" calls the API; "echo" prefixes text with the target code for local
# checks without a key; "off" disables translation entirely.
T2L_TRANSLATION_BACKEND=sarvam
# Get from the sarvam.ai dashboard. Leave empty to disable translation.
SARVAM_API_KEY=
# sarvam-translate:v1 accepts 2000 input characters, mayura:v1 only 1000.
SARVAM_MODEL=sarvam-translate:v1
SARVAM_TIMEOUT_SECONDS=5

# Voice input on Chainlit's native mic control. Backend "sarvam" calls Sarvam's own
# speech-to-text model (same key as SARVAM_API_KEY above) and covers all 22 teaching
# languages properly, including the low-resource ones Whisper doesn't know. "openrouter"
# calls Whisper large-v3 via OpenRouter instead (same key as OPENROUTER_API_KEY above;
# only ~15 of the 22 languages transcribe well). "echo" returns a placeholder for local
# testing without a key; "off" disables voice input.
T2L_TRANSCRIPTION_BACKEND=sarvam
SARVAM_STT_MODEL=saaras:v3
WHISPER_MODEL=openai/whisper-large-v3
WHISPER_TIMEOUT_SECONDS=30
