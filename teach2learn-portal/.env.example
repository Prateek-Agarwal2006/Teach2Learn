# Application
APP_NAME=EquitableT2L
ADMIN_EMAILS=f20230309@pilani.bits-pilani.ac.in,f20230985@pilani.bits-pilani.ac.in
OPENROUTER_API_KEY=
FINAL_FEEDBACK_MODEL=openai/gpt-5.6-luna
FINAL_FEEDBACK_REASONING_EFFORT=high
OPENROUTER_TIMEOUT_SECONDS=90
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
APP_MODULE=app.main:app
# Optional: use an existing server environment that already contains CUDA packages.
APP_PYTHON=
SECRET_KEY=replace-with-a-long-random-value
COOKIE_HTTPS_ONLY=true

# Google OAuth. Prefer the mode-600 JSON file over putting the client secret
# directly in this environment file.
GOOGLE_OAUTH_CLIENT_FILE=./secrets/google-oauth-client.json
GOOGLE_OAUTH_REDIRECT_URI=https://learnbyteaching.sasanktumpati.com/auth/callback
GOOGLE_ALLOWED_DOMAINS=pilani.bits-pilani.ac.in
PUBLIC_ORIGIN=https://learnbyteaching.sasanktumpati.com

# Persistent state
T2L_DATA_DIR=./data
T2L_DATABASE_PATH=./data/portal.sqlite3
T2L_TRANSCRIPT_DIR=./data/transcripts

# Logging: set T2L_LOGGING_ENABLED=false to silence application logs.
T2L_LOGGING_ENABLED=true
T2L_LOG_LEVEL=INFO
# Leave empty to log only to the systemd journal.
T2L_LOG_FILE=
T2L_EVALUATION_ENABLED=false
# Student Likert questions and written reflection are disabled by default.
T2L_STUDENT_QUESTIONNAIRE_ENABLED=false

# Multilingual. Translation wraps only participant-visible text; inference,
# evaluation, and stored transcripts always stay English.
# Backend "sarvam" calls the API; "echo" prefixes text with the target code for
# local checks without a key; "off" disables translation entirely.
T2L_TRANSLATION_BACKEND=sarvam
# Get from the sarvam.ai dashboard. Leave empty to disable translation.
SARVAM_API_KEY=
# sarvam-translate:v1 accepts 2000 input characters, mayura:v1 only 1000.
SARVAM_MODEL=sarvam-translate:v1
SARVAM_TIMEOUT_SECONDS=5
# Language preselected on the topic-selection form.
T2L_DEFAULT_LANGUAGE=en

# Local-only password-free sign-in. Ignored unless APP_ENV is not production.
T2L_DEV_LOGIN_ENABLED=false

# Inference. Keep fake for local UI work; use transformers only on the GPU server.
INFERENCE_BACKEND=fake
INFERENCE_ADAPTER_ROOT=/data/scratch/sanyam_jain_2022/mistral_finetune/gemma2_s9b
INFERENCE_LOCAL_FILES_ONLY=true
# Prevent even metadata requests to Hugging Face; all models must already be cached.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
INFERENCE_DEVICE_MAP=auto
INFERENCE_TORCH_DTYPE=bfloat16
INFERENCE_MAX_LOADED_MODELS=1
INFERENCE_MAX_NEW_TOKENS=192
INFERENCE_TEMPERATURE=0.2
INFERENCE_TOP_P=0.9
# Optional JSON overrides for base models or routing.
INFERENCE_PROFILES=
INFERENCE_SUBJECT_MODELS=

# Reverse-proxy deployment
TRUSTED_HOSTS=learnbyteaching.sasanktumpati.com,localhost,127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional named Cloudflare Tunnel. Create the tunnel in Cloudflare first and
# keep its token only in the server .env; quick tunnels do not use this value.
CLOUDFLARE_TUNNEL_TOKEN=
