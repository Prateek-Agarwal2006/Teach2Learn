[Unit]
Description=EquitableT2L web portal
Documentation=file:///data/scratch/sanyam_jain_2022/teach2learn-portal/README.md
Wants=network-online.target teach2learn-vllm.service
After=network-online.target teach2learn-vllm.service
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/data/scratch/sanyam_jain_2022/teach2learn-portal
EnvironmentFile=/data/scratch/sanyam_jain_2022/teach2learn-portal/.env
ExecStart=/data/scratch/sanyam_jain_2022/teach2learn-portal/scripts/run.sh
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGINT
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
